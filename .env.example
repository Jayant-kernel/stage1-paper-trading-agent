# Stage 1 is paper-only. This value is validated and cannot be changed to live.
APP_ENV=paper
LIVE_ORDER_ENDPOINTS_ENABLED=false

# FYERS API v3 data access. Keep real values only in the untracked .env file
# or Windows Credential Manager. Never commit or paste them into prompts.
FYERS_CLIENT_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=http://127.0.0.1:8765/callback
FYERS_ACCESS_TOKEN=

# Outbound-only alerts (disabled until configured).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional future shadow challengers. Disabled in config/stage1.yaml.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

